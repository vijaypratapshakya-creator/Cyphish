# ==============================================================================
# CyPhish - Minimal Production Bootstrap Configuration
# ==============================================================================
# All remaining configurations (LDAP/Active Directory, Scheduled Reports,
# Public Campaign URLs, SIEM Logging, AI/Ollama) are managed directly from the
# Web GUI at https://<your-server-ip>/console/settings.
# ==============================================================================

NODE_ENV=production

# Initial Administrator bootstrap password (used only on first startup)
ADMIN_PASSWORD=Admin@123

# Long random string used to sign session JWTs (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret-key-at-least-32-characters

# MongoDB credentials (passwords with '@', '#', '%', etc. are automatically URL-encoded)
MONGO_ROOT_USERNAME=cyphish_root
MONGO_ROOT_PASSWORD=RootPassword123
MONGO_APP_USERNAME=cyphish_app
MONGO_APP_PASSWORD=Admin@123

# Optional: Host IP or Domain used for generating self-signed SSL certificates
SERVER_HOST=192.168.88.11

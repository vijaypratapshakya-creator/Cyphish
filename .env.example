NODE_ENV=production
PORT=8080
DB_URL=mongodb://cyphish_user:change-this-password@mongodb:27017/cyphish?authSource=cyphish
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-before-first-start

# Restrict proxy trust to your reverse-proxy topology. Set false when none is used.
TRUST_PROXY=false
# Comma-separated administrator report recipients; reporting remains disabled if empty.
REPORT_RECIPIENTS=
REPORT_CRON=0 8 * * 1
REPORT_SMTP_PROFILE_ID=
CAMPAIGN_PUBLIC_URL=https://cyphish.example.com

# LDAP is disabled unless explicitly enabled. Use a read-only bind account.
LDAP_ENABLED=false
LDAP_URL=ldap://ad.example.internal:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=example,DC=internal
LDAP_TIMEOUT_MS=10000
